raw_text = "~ start
if States.has_talked_to_guard:
	if not States.bell_rang:
		set States.bell_rang = true
		set States.gate_openable = true
		Guard: Oh! Finally the bell rang
		Guard: I can finally go home!
	else:
		\"\": Stop ringing the bell!
else:
	Hiro: The bell is made of polished gold. I have no reason to ring this right now.
=> END"
metadata/dialogue_manager_version = "3.10.4"
