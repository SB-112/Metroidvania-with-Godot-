"24": {
&"id": "24",
&"next_id": "25",
&"text": "\"Why is the village so terrified of what's beyond?\"",
&"type": "response"
},
"25": {
&"character": "Guard",
&"id": "25",
&"next_id": "26",
&"text": "\"Fear is what keeps this community intact. History proves that those who foolishly cross the threshold never return to tell the story.\"",
&"type": "dialogue"
},
